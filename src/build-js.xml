<project name="build-js" xmlns:if="ant:if">

  <property name="node.windows" location="c:/Program Files/nodejs/node.exe"/>
  <property name="node-modules.home.windows" location="c:/Program Files/nodejs/node_modules"/>
  <property name="node.linux" location="/usr/bin/node"/>
  <property name="node-modules.home.linux" location="/usr/lib/node_modules"/>
  <property name="npm.dir" location="${basedir}/npm"/>
  <property name="localNodePackages" value=""/>
  <property name="js-lint-tool" value="node_modules/@spiralcraft/svelte-ui-mk1/tools/sc-ui-lint.js"/>
  
  <target name="test.npm">
    <available file="${npm.dir}/package.json" property="has.npm"/>
  </target>
  
  <target name="test.rollup">
    <available file="${npm.dir}/rollup.config.js" property="has.rollup"/>
  </target>

  <target name="test.vite">
    <available file="${npm.dir}/vite.config.js" property="has.vite"/>
  </target>

  <target name="test.bundler" depends="test.rollup,test.vite">
    <condition property="has.bundler">
      <or>
        <isset property="has.rollup"/>
        <isset property="has.vite"/>
      </or>
    </condition>
  </target>
  
  <macrodef name="npm">
    <element name="args" implicit="true"/>
    <sequential>
      <exec osfamily="windows" executable="${node.windows}" dir="${npm.dir}" failonerror="true">
        <arg value="${node-modules.home.windows}/npm/bin/npm-cli.js"/>
        <args/>
      </exec>
      <exec osfamily="unix" executable="${node.linux}" dir="${npm.dir}" failonerror="true">
        <arg value="${node-modules.home.linux}/npm/bin/npm-cli.js"/>
        <args/>
      </exec>
    </sequential>
  </macrodef>
  
  <target name="npm-install" 
    description="Update node.js modules" 
    if="has.npm" 
    depends="test.npm"
    >
    <echo>npm-install ${localNodePackages}</echo>
    <delete dir="${npm.dir}/node_modules/@spiralcraft" quiet="true"/>
    <npm>
      <arg value="install"/>
      <arg value="--install-links"/>
      <arg line="${localNodePackages}"/>      
    </npm>
    
  </target>

  <!-- JS lint: runs only when js-lint-conf is set (e.g. in the root build.xml or a
       properties file) to the path of a lint config. The tool defaults to sc-ui-lint from
       the installed model; a project can point js-lint-tool at another script that takes
       the same config argument. -->


  <target name="lint-js" description="Check JS imports (when js-lint-conf is set)"
          if="js-lint-conf" depends="test.npm">
    <!-- a configured but missing file is an error, not a silent skip -->
    <fail message="js-lint-conf is set to ${js-lint-conf}, but that file doesn't exist">
      <condition><not><available file="${js-lint-conf}"/></not></condition>
    </fail>
    <echo>lint-js: ${js-lint-conf}</echo>
    <exec osfamily="windows" executable="${node.windows}" dir="${npm.dir}" failonerror="true">
      <arg value="${js-lint-tool}"/>
      <arg value="--config"/>
      <arg file="${js-lint-conf}"/>
    </exec>
    <exec osfamily="unix" executable="${node.linux}" dir="${npm.dir}" failonerror="true">
      <arg value="${js-lint-tool}"/>
      <arg value="--config"/>
      <arg file="${js-lint-conf}"/>
    </exec>
  </target>  
  
  <target name="build-js" description="Js bundles" if="has.bundler" depends="test.bundler,lint-js">
    <echo>build-js</echo>
    <echo>build-js:pre-build</echo>
    <exec osfamily="windows" executable="${node.windows}" dir="npm" failonerror="true">
      <arg value="${node-modules.home.windows}/npm/bin/npm-cli.js"/>
      <arg value="run"/>
      <arg value="pre-build"/>
      <arg value="--if-present=true"/>
    </exec>
    <exec osfamily="unix" executable="${node.linux}" dir="npm" failonerror="true">
      <arg value="${node-modules.home.linux}/npm/bin/npm-cli.js"/>
      <arg value="run"/>
      <arg value="pre-build"/>
      <arg value="--if-present=true"/>
    </exec>

    <echo>build-js:rollup</echo>
    <exec osfamily="windows" executable="${node.windows}" dir="npm" failonerror="true" if:set="has.rollup">
      <arg value="--import"/>
      <arg value="./node-hooks.mjs"/>
      <arg value="node_modules/rollup/dist/bin/rollup"/>
      <arg value="--config"/>
      <arg value="rollup.config.js"/>
  
    </exec>
    <exec osfamily="unix" executable="${node.linux}" dir="npm" failonerror="true" if:set="has.rollup">
      <arg value="--import"/>
      <arg value="./node-hooks.mjs"/>
      <arg value="node_modules/rollup/dist/bin/rollup"/>
      <arg value="--config"/>
      <arg value="rollup.config.js"/>
  
    </exec>

    <echo>build-js:vite</echo>
    <exec osfamily="windows" executable="${node.windows}" dir="npm" failonerror="true" if:set="has.vite">
      <arg value="node_modules/vite/bin/vite.js"/>
      <arg value="build"/>
      <arg value="--config"/>
      <arg value="vite.config.js"/>  
    </exec>
    <exec osfamily="unix" executable="${node.linux}" dir="npm" failonerror="true" if:set="has.vite">
      <arg value="node_modules/vite/bin/vite.js"/>
      <arg value="build"/>
      <arg value="--config"/>
      <arg value="vite.config.js"/>  
    </exec>

    
    <echo>build-js:post-build</echo>
    <exec osfamily="windows" executable="${node.windows}" dir="npm" failonerror="true">
      <arg value="${node-modules.home.windows}/npm/bin/npm-cli.js"/>
      <arg value="run"/>
      <arg value="post-build"/>
      <arg value="--if-present=true"/>
    </exec>
    <exec osfamily="unix" executable="${node.linux}" dir="npm" failonerror="true">
      <arg value="${node-modules.home.linux}/npm/bin/npm-cli.js"/>
      <arg value="run"/>
      <arg value="post-build"/>
      <arg value="--if-present=true"/>
    </exec>

  </target>

  <target name="extract-js" description="Extract all js libs to lib-js">
    <echo>extract-js</echo>
  </target>
    
</project>